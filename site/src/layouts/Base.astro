---
import '@fontsource-variable/geist';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, routes, project } from '../i18n/index.js';

const { lang = 'es', routeKey = 'home', title, description, jsonLd = null } = Astro.props;

const c = t(lang);
const other = lang === 'es' ? 'en' : 'es';
const selfPath = routes[lang][routeKey];
const altPath = routes[other][routeKey];

const canonical = new URL(selfPath, Astro.site).href;
const altUrl = new URL(altPath, Astro.site).href;
const esUrl = lang === 'es' ? canonical : altUrl;
const pageTitle = title ?? c.meta.title;
const pageDescription = description ?? c.meta.description;
const ogImage = new URL('/og.png', Astro.site).href;

const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS, Linux',
  softwareVersion: project.version,
  description: c.meta.description,
  url: Astro.site?.href,
  inLanguage: ['es', 'en'],
  license: 'https://opensource.org/license/mit',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: project.releasesUrl,
  codeRepository: project.repoUrl,
  author: { '@type': 'Person', name: 'Marks Calderon' },
  publisher: { '@type': 'Organization', name: 'Codeplai Games', url: project.parentUrl, email: project.email },
};
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={lang === 'es' ? 'es-PE' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'es' ? 'es-PE' : 'en'} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VizcachaIDE" />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_PE'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline set:html={JSON.stringify(app)} type="application/ld+json" />
    {jsonLd && <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />}

    {/* Aplica el tema antes de pintar: evita el parpadeo al cargar. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('vz_theme');
          if (saved !== 'dark' && saved !== 'light') {
            saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', saved);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{c.skipToContent}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('vz_theme', next);
        } catch (err) {}
      });
    </script>
  </body>
</html>
