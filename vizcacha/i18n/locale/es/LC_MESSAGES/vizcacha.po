msgstr "Cambios sin guardar"

#, python-brace-format
msgid "Do you want to save changes to '{name}'?"
msgstr "¿Quieres guardar los cambios en '{name}'?"

msgid "Error"
msgstr "Error"

msgid "Find"
msgstr "Buscar"

msgid "Replace"
msgstr "Reemplazar"

msgid "Match case"
msgstr "Coincidir mayúsculas"

msgid "Whole word"
msgstr "Palabra completa"

msgid "Previous"
msgstr "Anterior"

msgid "Next"
msgstr "Siguiente"

msgid "Replace All"
msgstr "Reemplazar todo"

#, python-brace-format
msgid "{count} replacement"
msgid_plural "{count} replacements"
msgstr[0] "{count} reemplazo"
msgstr[1] "{count} reemplazos"

msgid "No matches"
msgstr "Sin coincidencias"

#, python-brace-format
msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} coincidencia"
msgstr[1] "{count} coincidencias"

#, python-brace-format
msgid "Could not open file: {error}"
msgstr "No se pudo abrir el archivo: {error}"

#, python-brace-format
msgid "Untitled {number}"
msgstr "Sin título {number}"

#, python-brace-format
msgid "Try this: {hint}"
msgstr "Prueba esto: {hint}"

msgid "Original message from Go:"
msgstr "Mensaje original de Go:"

msgid "Go to line"
msgstr "Ir a la línea"

msgid "Search this error"
msgstr "Buscar este error"

msgid "Assistant"
msgstr "Asistente"

msgid "Nothing to explain. When Go reports an error, I will explain it here."
msgstr "Nada que explicar. Cuando Go informe de un error, te lo explicaré aquí."

#, python-brace-format
msgid "Go reported {count} problem:"
msgid_plural "Go reported {count} problems:"
msgstr[0] "Go informó de {count} problema:"
msgstr[1] "Go informó de {count} problemas:"

#, python-brace-format
msgid "{file}, line {line}"
msgstr "{file}, línea {line}"

msgid "Go reported a problem"
msgstr "Go informó de un problema"

msgid ""
"There is no beginner explanation for this message yet. The text below is exactly what Go printed:"
" searching for it on the web usually helps."
msgstr ""
"Todavía no hay una explicación para principiantes de este mensaje. El texto de abajo es "
"exactamente lo que imprimió Go: buscarlo en la web suele ayudar."

msgid "🐛 Debug"
msgstr "🐛 Depurar"

msgid "⏩ Continue"
msgstr "⏩ Continuar"

msgid "↷ Step Over"
msgstr "↷ Paso sobre"

msgid "↓ Step Into"
msgstr "↓ Paso adentro"

msgid "↑ Step Out"
msgstr "↑ Paso afuera"

msgid "Run to &Cursor"
msgstr "Ejecutar hasta el &cursor"

msgid "Stop Debugging"
msgstr "Detener depuración"

msgid "Toggle &Breakpoint"
msgstr "Activar/desactivar &punto de interrupción"

msgid "Variables"
msgstr "Variables"

msgid "Call Stack"
msgstr "Pila de llamadas"

msgid "Goroutines"
msgstr "Goroutines"

msgid "No File"
msgstr "Sin archivo"

msgid "Please save your file before debugging."
msgstr "Guarda tu archivo antes de depurar."

msgid "Note: the program cannot read keyboard input (stdin) while debugging."
msgstr "Nota: el programa no puede leer del teclado (stdin) mientras se depura."

msgid "[Debugging stopped]"
msgstr "[Depuración detenida]"

#, python-brace-format
msgid "[Debugging finished with code {code}]"
msgstr "[La depuración terminó con código {code}]"

msgid "Loading..."
msgstr "Cargando..."

msgid "Name"
msgstr "Nombre"

msgid "Type"
msgstr "Tipo"

msgid "Value"
msgstr "Valor"

msgid "Light"
msgstr "Claro"

msgid "Dark"
msgstr "Oscuro"

msgid "Solarized Light"
