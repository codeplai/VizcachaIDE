---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import Logo from './Logo.astro';
import { t, routes, project } from '../i18n/index.js';

const { lang = 'es', routeKey = 'home' } = Astro.props;
const c = t(lang);
const r = routes[lang];
const other = lang === 'es' ? 'en' : 'es';
const selfHref = r[routeKey];
const altHref = routes[other][routeKey];

const links = [
  { href: `${r.home}#que-puedes-hacer`, label: c.nav.features },
  { href: `${r.home}#descargar`, label: c.nav.download },
  { href: r.manual, label: c.nav.manual, current: routeKey === 'manual' },
  { href: project.repoUrl, label: c.nav.source, external: true },
];
---

<header class="header" id="site-header">
  <div class="header__inner">
    <a class="brand" href={r.home} aria-label="VizcachaIDE">
      <Image src={mark} alt="" width={32} height={32} class="brand__mark" />
      <Logo />
    </a>

    <nav class="nav" aria-label={c.navLabel}>
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.current ? 'page' : undefined} rel={l.external ? 'noopener' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__tools">
      <a class="parentlink" href={project.parentUrl} rel="noopener">{c.parentLink}</a>

      <div class="langswitch" role="group" aria-label={c.langLabel}>
        <a href={lang === 'es' ? selfHref : altHref} lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
        <a href={lang === 'en' ? selfHref : altHref} lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>

      <button class="iconbtn" type="button" data-theme-toggle aria-label={c.themeLabel}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"></path>
        </svg>
      </button>

      <button class="iconbtn menubtn" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={c.menuLabel}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>

      <a class="btn header__cta" href={`${r.home}#descargar`}>{c.headerCta}</a>
    </div>
  </div>

  <div class="mobilemenu" id="mobile-menu" data-open="false">
    {links.map((l) => <a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a>)}
    <a href={project.parentUrl} rel="noopener">{c.parentLink}</a>
    <a class="btn" href={`${r.home}#descargar`}>{c.headerCta}</a>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    var menu = document.getElementById('mobile-menu');
    var btn = document.querySelector('[data-menu-toggle]');

    // Borde inferior solo al hacer scroll.
    var onScroll = function () {
      header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    if (btn && menu) {
      btn.addEventListener('click', function () {
        var open = menu.dataset.open === 'true';
        menu.dataset.open = open ? 'false' : 'true';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
      menu.addEventListener('click', function (e) {
        if (e.target.tagName === 'A') {
          menu.dataset.open = 'false';
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
