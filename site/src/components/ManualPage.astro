---
import Base from '../layouts/Base.astro';
import ManualBody from './ManualBody.astro';
import { t } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const c = t(lang);
---

<Base lang={lang} routeKey="manual" title={c.meta.manualTitle} description={c.meta.manualDescription}>
  <ManualBody lang={lang} />
</Base>
